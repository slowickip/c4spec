{
  "name": "@slowickip/c4spec",
  "version": "0.1.0-alpha.4",
  "description": "C4Spec command line for LikeC4 models and Git reviews",
  "keywords": [
    "c4spec",
    "c4",
    "likec4",
    "architecture",
    "cli",
    "diagrams"
  ],
  "homepage": "https://github.com/slowickip/c4spec#readme",
  "bugs": {
    "url": "https://github.com/slowickip/c4spec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slowickip/c4spec.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.3 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "c4spec": "bin/c4spec.js"
  },
  "files": [
    "bin",
    "dist",
    ".agents/skills/**/*.md",
    ".agents/skills/**/*.txt",
    ".agents/skills/**/*.json",
    ".agents/skills/**/*.c4",
    ".agents/skills/**/*.py",
    ".agents/skills/**/LICENSE",
    ".agents/skills/**/NOTICE",
    "licenses",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/c4-governance.md",
    "docs/consumer-guide.md",
    "docs/skill-distribution.md",
    "docs/upstream-reuse.md",
    ".github/workflows/pr-model-diff.yml",
    "scripts/pr_model_diff.py",
    "prototype/native-diff-first/inline_diff.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version:ci": "changeset version && npm install --package-lock-only --ignore-scripts",
    "check:pack-version": "node scripts/pack-version-check.mjs",
    "release:ci": "npm run check:pack-version && changeset publish"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "14.0.3",
    "likec4": "1.61.0",
    "skills": "1.8.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
