{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C4Spec durable behavioral obligations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "appliesTo",
          "verificationRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verificationRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
